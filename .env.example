# Copy to .env for local development. Never commit .env.
PORT=3000
DATABASE_URL=postgres://printflow:printflow@localhost:5432/printflow

# Production: serve over HTTPS and set this to true (Secure cookies, HSTS upgrade).
# COOKIE_SECURE=true
# Local demo only: enables /api/samples, SEED_ON_START and DEMO_RESET_MINUTES.
# ENABLE_DEMO=true
# First admin: PF_PASSWORD='at-least-12-chars' npm run user:create -- you@example.com "Your Name" admin
