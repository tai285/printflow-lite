# Copy to .env.production (git-ignored) on the machine that runs the app.
# Used by compose.prod.yaml and `npm run deploy`.

# Database password. Generate one: openssl rand -hex 24   (keep it URL-safe)
POSTGRES_PASSWORD=

# Which tunnel to run: "quick" (free, address changes on restart) or "named"
# (stable address; needs a Cloudflare account, a hostname and TUNNEL_TOKEN).
COMPOSE_PROFILES=quick
# TUNNEL_TOKEN=

# Permanent public address, once you have one (makes the site indexable).
# SITE_URL=https://your-name.example.org

# Optional tuning
# RATE_LIMIT_MAX=60
# AUTH_RATE_LIMIT_MAX=10
